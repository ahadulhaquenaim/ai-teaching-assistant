# Copy to backend/.env for local development. Never commit real values.
# On Render, set these in the service's Environment settings instead.

# ---------------------------------------------------------------- app
ENVIRONMENT=development            # development | production | test
LOG_LEVEL=INFO
LOG_FORMAT=pretty                  # pretty (colored, readable) | json (one object per line)
# Comma-separated Streamlit origins allowed by CORS
CORS_ORIGINS=http://localhost:8501

# -------------------------------------------------------------- mongo
# MongoDB Atlas M0 connection string (mongodb+srv://...)
MONGODB_URI=
MONGODB_DB_NAME=ai_teaching_assistant
MONGODB_TIMEOUT_MS=10000

# NOTE(auth): Google login is deferred. Every request is currently treated as
# a single fixed local user (see app/core/dependencies.py). No JWT/Google
# settings are needed until that phase is implemented.

# ---------------------------------------------------------------- LLM
# Providers: gemini | groq | openrouter
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.6-flash
# Used automatically when the primary provider is rate-limited or failing.
# Set LLM_FALLBACK_PROVIDER=none to disable the fallback.
LLM_FALLBACK_PROVIDER=openrouter
LLM_FALLBACK_MODEL=openrouter/free
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
# Thinking depth for Gemini 3+ models: none | minimal | low | medium | high
LLM_REASONING_EFFORT=low

# Only the keys of the selected providers (primary + fallback) are required.
# GOOGLE_API_KEY is also used for Gemini embeddings.
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# --------------------------------------------------------- embeddings
EMBEDDING_MODEL=gemini-embedding-001
# Must equal the Pinecone index dimension
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=50
EMBEDDING_BATCH_DELAY_SECONDS=1.0

# ----------------------------------------------------------- pinecone
PINECONE_API_KEY=
PINECONE_INDEX_NAME=ai-teaching-assistant
PINECONE_UPSERT_BATCH_SIZE=100
RETRIEVAL_TOP_K=5
# Recent messages used to rewrite follow-up questions
CHAT_HISTORY_MESSAGES=8

# ---------------------------------------------------------- ingestion
MAX_UPLOAD_SIZE_MB=25
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
# Pinecone Starter: 100 namespaces per index (one namespace per document)
MAX_DOCUMENTS_TOTAL=95
MAX_DOCUMENTS_PER_USER=5
# DOCX has no real pages: text is split into sections of this size
DOCX_CHARS_PER_PAGE=3000
# PDFs below this average are rejected as scanned (OCR not supported)
MIN_AVG_CHARS_PER_PAGE=50
SUMMARY_MAX_INPUT_CHARS=12000

# --------------------------------------------------------------- quiz
QUIZ_MAX_QUESTIONS=10
QUIZ_MAX_RETRIES=2
QUIZ_CONTEXT_CHUNKS=12
QUIZ_CONTEXT_MAX_CHARS=14000

# --------------------------------------------------------- web search
# DuckDuckGo (ddgs) - no API key needed
WEB_SEARCH_DAILY_LIMIT=20
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT_SECONDS=15
# ddgs engine: keep "duckduckgo" ("auto" also queries Google/Bing/Brave/etc.)
WEB_SEARCH_BACKEND=duckduckgo
WEB_SEARCH_REGION=us-en
WEB_SEARCH_MAX_CHARS_PER_RESULT=1200
# Cache identical queries for 24h in MongoDB (cache hits don't use the daily limit)
WEB_SEARCH_CACHE_ENABLED=true
