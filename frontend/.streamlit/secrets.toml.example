# Copy to frontend/.streamlit/secrets.toml for local runs (never commit it).
# On Streamlit Community Cloud paste the same content into App settings -> Secrets.

# URL of the FastAPI backend (Render), no trailing slash.
BACKEND_URL = "http://localhost:8000"

# --- Google login (deferred) -------------------------------------------------
# Not used yet: the backend currently treats every request as one local user.
# When auth is enabled, fill this in and expose the ID token to the app:
#
# [auth]
# redirect_uri = "http://localhost:8501/oauth2callback"
# cookie_secret = "<long random string>"
# expose_tokens = ["id"]
#
# [auth.google]
# client_id = "<google-oauth-client-id>.apps.googleusercontent.com"
# client_secret = "<google-oauth-client-secret>"
# server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
